{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Visualize results",
            "type": "debugpy",
            "request": "launch",
            "module": "experiments.sir_with_confinements.visualize_social_optimum_results",
            "args": [
                "--images-dir",
                "outputs/social_optimum/olive_clock/plot"
            ]
        },
        {
            "name": "experiments.sir_with_confinements.generate_nash_equilibrium_results",
            "type": "debugpy",
            "request": "launch",
            "module": "experiments.sir_with_confinements.generate_nash_equilibrium_results",
            "args": [
                "--output_dir",
                "outputs/nash_equilibrium/all/plot"
            ]
        },
        {
            "name": "SIR: Compute Social optimum",
            "type": "debugpy",
            "request": "launch",
            "module": "src.sir_with_confinements.social_optimum",
            "args": [
                "--N",
                "30",
                "--encounter_rate",
                "0.3",
                "--recovery_rate",
                "0.7",
                "--cost_infection",
                "5.5",
                "--cost_lockdown",
                "1",
                "--discount_factor",
                "0.99"
            ]
        },
        {
            "name": "SIR: Compute Nash Equilibrium",
            "type": "debugpy",
            "request": "launch",
            "module": "src.sir_with_confinements.nash_equilibrium",
            "args": [
                "--N",
                "30",
                "--encounter_rate",
                "0.3",
                "--recovery_rate",
                "0.7",
                "--cost_infection",
                "5.5",
                "--cost_lockdown",
                "1",
                "--discount_factor",
                "0.99"
            ]
        },
        {
            "name": "SIRS: Compute Social optimum",
            "type": "debugpy",
            "request": "launch",
            "module": "src.sirs_with_confinements.social_optimum",
            "args": [
                "--N",
                "30",
                "--encounter_rate",
                "0.7",
                "--recovery_rate",
                "0.3",
                "--susceptible_rate",
                "0.2",
                "--cost_infection",
                "5.5",
                "--cost_lockdown",
                "1",
                "--discount_factor",
                "0.99"
            ]
        },
        {
            "name": "SIRS: Compute Nash Equilibrium",
            "type": "debugpy",
            "request": "launch",
            "module": "src.sirs_with_confinements.nash_equilibrium",
            "args": [
                "--N",
                "30",
                "--encounter_rate",
                "0.3",
                "--recovery_rate",
                "0.7",
                "--susceptible_rate",
                "0.2",
                "--cost_infection",
                "5.5",
                "--cost_lockdown",
                "1",
                "--discount_factor",
                "0.99"
            ]
        },
    ]
}